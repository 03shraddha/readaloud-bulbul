# Copy to backend/.env and fill in values as needed.
# backend/config.js parses this file itself (no dotenv dependency); real
# process environment variables always take precedence over this file.

# Sarvam Bulbul v3 API key. If unset, the server automatically falls back to
# MOCK_TTS mode (with a loud startup warning) so local dev works with zero
# credentials.
SARVAM_API_KEY=

# Port the Express server listens on.
PORT=8787

# Force mock synthesis even if SARVAM_API_KEY is set (1/true/yes). Useful for
# demos, CI, and the test/smoke.mjs suite.
MOCK_TTS=0

# Simulated latency (ms) added to every mock synthesis call, so the
# extension's prefetch/queue logic can be exercised realistically.
MOCK_LATENCY_MS=250

# Fraction (0..1) of mock requests that randomly fail with UPSTREAM_ERROR, so
# the extension's retry logic can be exercised.
MOCK_FAIL_RATE=0

# Comma-separated extra origins allowed by CORS, in addition to every
# chrome-extension:// origin (which is always allowed).
ALLOWED_ORIGINS=

# Milliseconds to wait for the upstream Sarvam API before aborting with
# UPSTREAM_TIMEOUT (504).
UPSTREAM_TIMEOUT_MS=20000
