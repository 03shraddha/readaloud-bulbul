{
  "manifest_version": 3,
  "name": "Cadence",
  "version": "0.1.0",
  "description": "Read any page aloud — sentence-by-sentence text-to-speech that works on articles, blogs, and social feeds, including X/Twitter timelines.",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cadence: read this page aloud"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "offscreen",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8787/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/*",
        "src/shared/text/*",
        "src/content/*",
        "src/content/extract/*",
        "src/content/extract/lib/*",
        "src/content/ui/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
